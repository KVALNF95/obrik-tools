# Настройка отправки отчётов о проблемах (кнопка «Сообщить о проблеме»).
# Скопируйте этот файл в report.cfg и заполните. report.cfg в git НЕ попадает.

# ── Основной вариант: приёмник отчётов на сервере (через WG-туннель) ──
# Доступ только по X-Report-Token: единственное право — положить уведомление,
# дальше сервер сам его доставляет. URL виден только из VPN.
method       = reports
report_url   = http://10.50.0.1:8080/api/reports
report_token = ВСТАВИТЬ_ТОКЕН


# ── Вариант 1: Telegram ──
# 1. Создайте бота: напишите @BotFather → /newbot → получите токен.
# 2. Напишите своему боту любое сообщение.
# 3. Узнайте свой chat_id: откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates и найдите "chat":{"id":...}.
method   = telegram
tg_token = 123456789:AbCdEf...ваш_токен
tg_chat  = 111222333

# ── Вариант 2: электронная почта (SMTP, работает без VPN) ──
# Рекомендуется Яндекс или Mail.ru — доступны из РФ без VPN.
# Нужен «пароль приложения» (не обычный пароль от почты):
#   Яндекс:  id.yandex.ru → Безопасность → Пароли приложений → Почта
#   Mail.ru: id.mail.ru → Безопасность → Пароли для внешних приложений
# method    = email
# smtp_host = smtp.yandex.ru
# smtp_port = 465
# smtp_user = your_login@yandex.ru
# smtp_pass = пароль_приложения
# mail_to   = kuznetsovvova95@gmail.com    # куда слать отчёты
# mail_from = your_login@yandex.ru

# ── Вариант 3: вебхук на свой relay-сервер (БЕЗ секретов на ноуте) ──
# На ноуте — только URL и токен (им можно лишь отправить отчёт, легко сменить).
# Почтовые пароли живут на сервере (см. report_relay.py / relay.cfg).
# method        = webhook
# webhook_url   = https://report.ваш-домен/report
# webhook_token = тот_же_токен_что_в_relay.cfg
